# Copiar este archivo como `.env` y ajustar los valores para el entorno local.
# Ningún valor de este ejemplo debe usarse en producción.

# Clave utilizada por Flask para firmar datos internos de la aplicación.
CLAVE_SECRETA=cambiar-esta-clave-secreta-en-produccion

# Clave utilizada para firmar y verificar los tokens JWT.
CLAVE_TOKEN=cambiar-esta-clave-de-token-en-produccion

# Cantidad de minutos de vigencia de un token de acceso.
MINUTOS_VIGENCIA_TOKEN=480

# URL de conexión a la base de datos. Por defecto se usa SQLite en `proyecto/instance/`.
# Ejemplo para PostgreSQL: postgresql+psycopg://usuario:contrasena@servidor:5432/institucion
URL_BASE_DATOS=

# Zona horaria institucional usada para registrar las marcas de tiempo del servidor.
ZONA_HORARIA_INSTITUCIONAL=America/Argentina/Buenos_Aires

# Orígenes autorizados para el futuro frontend, separados por comas.
CORS_ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:3000
